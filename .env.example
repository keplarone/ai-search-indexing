# auto: call a provider when its key is set, otherwise use the local auditor
# live: always call providers; a missing key or a failed call is status=failed
# mock: never call providers; every judgment comes from the local auditor
VISIBILITY_PROVIDER_MODE=auto

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.8-flash
PERPLEXITY_MODEL=perplexity/sonar

# Optional overrides. Leave unset unless you are pointing at a proxy you control.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# The outbound client ignores HTTP(S)_PROXY unless this is true.
VISIBILITY_TRUST_ENV=false

MAX_KEYWORDS=15
MAX_OUTBOUND_CONCURRENCY=16
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8741

# Restricted key (rk_) with permission to create subscription-item usage records.
# Do not commit a live key. Store it in the platform secrets vault.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. When set, /v1/webhooks/stripe rejects every other source address.
# STRIPE_WEBHOOK_IP_ALLOWLIST=
# Set true only behind a proxy that overwrites X-Forwarded-For.
# STRIPE_TRUST_PROXY=false
# BILLING_REGISTRY_PATH=data/billing_registry.sqlite
# MAX_BILLABLE_KEYWORDS=100000
